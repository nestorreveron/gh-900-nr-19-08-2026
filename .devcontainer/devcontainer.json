{
  "name": "Contoso Customer Portal GH-900",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "GitHub.copilot", "GitHub.copilot-chat"]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && python scripts/demo_setup.py",
  "forwardPorts": [5000],
  "portsAttributes": {"5000": {"label": "Flask app", "onAutoForward": "notify"}}
}
